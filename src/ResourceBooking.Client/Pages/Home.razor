@page "/"
@inject HttpClient Http
@inject MeAuthenticationStateProvider AuthState

<PageTitle>Resource booking</PageTitle>

<h1>Resource booking</h1>

<AuthorizeView>
    <Authorized>
        <p>Signed in as @context.User.Identity?.Name.</p>
        <button type="button" @onclick="SignOutAsync">Sign out</button>
    </Authorized>
    <NotAuthorized>
        <p><a href="sign-in">Sign in</a> to book rooms, cars and catering.</p>
    </NotAuthorized>
</AuthorizeView>

@if (signOutFailed)
{
    <p role="alert">Signing out didn't work. Try again.</p>
}

@code {
    private bool signOutFailed;

    private async Task SignOutAsync()
    {
        var response = await Http.PostAsync("api/auth/sign-out", null);
        signOutFailed = !response.IsSuccessStatusCode;
        AuthState.Refresh();
    }
}
