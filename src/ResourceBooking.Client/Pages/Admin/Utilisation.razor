@page "/admin/utilisation"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient Api
@inject CompanyClock Clock

<PageTitle>Utilisation</PageTitle>

<h1>Utilisation</h1>
<p class="hint">Booked time over open time, for the days from and to, both included. Kitchens count orders over orders they can take. London time.</p>

<div class="filters">
    <label class="field"><span>From</span><input type="date" @bind="from" /></label>
    <label class="field"><span>To</span><input type="date" @bind="to" /></label>
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="LoadAsync">Show</FluentButton>
</div>

@if (error is not null)
{
    <div role="alert"><FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@error</FluentMessageBar></div>
}

@if (rows is not null)
{
    <table class="bookings">
        <thead>
            <tr>
                <th scope="col">Resource</th>
                <th scope="col">Used</th>
                <th scope="col">Utilisation</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td>@r.Name @(r.LastDay is { } last ? $"(last day {last:d MMM yyyy})" : "")</td>
                    <td>@Used(r)</td>
                    <td class="ratio">
                        @if (r.Ratio is { } ratio)
                        {
                            <span class="bar" aria-hidden="true"><span style="width: @((Math.Min(ratio, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                            <span>@((ratio * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%</span>
                        }
                        else
                        {
                            <span>Not open in this range</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private DateOnly from;
    private DateOnly to;
    private List<UtilisationRow>? rows;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        to = Clock.Today.AddDays(-1);
        from = to.AddDays(-6);
        await LoadAsync();
    }

    private int load;

    /// <summary>Loads for the current filters; a slower answer for filters picked earlier is dropped.</summary>
    private async Task LoadAsync()
    {
        var mine = ++load;
        var result = await Api.UtilisationAsync(from, to);
        if (mine != load)
        {
            return;
        }
        error = result.Problem?.Message;
        rows = result.Value;
    }

    private static string Used(UtilisationRow r) => r.Type == ResourceType.Catering
        ? $"{r.Used:0} of {r.Available:0} unit-days"
        : $"{r.Used:0.#} of {r.Available:0.#} hours";
}
